    r"C:\Users\choya\AppData\Local\hermes\tools\ffmpeg-9.0.1-win32-x64\bin\ffprobe.exe",
    r"C:\ffmpeg\bin\ffprobe.exe")

FFMPEG_PATH = _find("ffmpeg",
    r"C:\Users\choya\AppData\Local\hermes\tools\ffmpeg-9.0.1-win32-x64\bin\ffmpeg.exe",
    r"C:\ffmpeg\bin\ffmpeg.exe")

VLC_PATH = _find("vlc",
    r"C:\Program Files\VideoLAN\VLC\vlc.exe",
    r"C:\Program Files (x86)\VideoLAN\VLC\vlc.exe")

LANG_MAP = {
    'hin': 'Hindi',   'hindi': 'Hindi',
    'tam': 'Tamil',   'tamil': 'Tamil',
    'tel': 'Telugu',  'telugu': 'Telugu',
    'kan': 'Kannada', 'kannada': 'Kannada',
    'mal': 'Malayalam',
    'eng': 'English', 'english': 'English',
    'und': 'Audio Track'
}

# ── Proxy Cache for Browser Player ─────────────────────────────────────────────
_proxy_cache = {}
_proxy_lock  = threading.Lock()

def store_proxy(url, referer=None):
    import hashlib
    key = hashlib.md5(url.encode()).hexdigest()[:12]
    with _proxy_lock:
        _proxy_cache[key] = {'url': url, 'referer': referer or ''}
    return f"http://localhost:{PORT}/api/proxy/{key}"

# ── HTTP Helpers ───────────────────────────────────────────────────────────────

def fetch_html(url, referer=None, extra_headers=None, timeout=15):
    headers = {
        'User-Agent': USER_AGENT,
        'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
        'Accept-Language': 'en-US,en;q=0.9,hi;q=0.8',
        'Accept-Encoding': 'gzip, deflate',
        'Connection': 'keep-alive',
    }
    if referer:
        headers['Referer'] = referer
    if extra_headers:
        headers.update(extra_headers)
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        raw = resp.read()
        final_url = resp.url
        try:
            raw = _gzip.decompress(raw)
        except Exception:
            pass
        return raw.decode('utf-8', errors='ignore'), final_url

def check_link_alive(url, referer=None):
    """Fast check whether a stream URL actually works or returns 403 NotEntitled."""
    try:
        headers = {
            'User-Agent': USER_AGENT,
            'Range': 'bytes=0-100'
        }
        if referer:
            headers['Referer'] = referer
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=4) as resp:
            data = resp.read(100)
            if b'NotEntitled' in data or b'<Error>' in data:
                return False
            return resp.status in (200, 206)
    except Exception:
        return False

def resolve_gpdl(gpdl_url, referer=None):
    """Follows GPDL redirect to cryptonewz and extracts direct Google UserContent CDN link."""
    try:
        headers = {
            'User-Agent': USER_AGENT,
            'Referer': referer or 'https://gamerxyt.com/'
        }
        req = urllib.request.Request(gpdl_url, headers=headers)
        with urllib.request.urlopen(req, timeout=12) as resp:
            final_url = resp.url
            parsed = urllib.parse.urlparse(final_url)
            qs = urllib.parse.parse_qs(parsed.query)
            if 'link' in qs and qs['link'][0].startswith('http'):
                return qs['link'][0]
            html = resp.read().decode('utf-8', errors='ignore')
            m = re.search(r'href=["\'](https?://video-downloads\.googleusercontent\.com/[^"\']+)["\']', html)
            if m:
                return m.group(1)
            m = re.search(r'id=["\']downloadBtn["\'][^>]*href=["\'](https?://[^"\']+)["\']', html)
            if m:
                return m.group(1)
    except Exception as e:
        print("[GPDL] Resolve error:", e)
    return None

def probe_audio_tracks(stream_url, referer=None):
    audio_tracks = []
    if not FFPROBE_PATH or not os.path.exists(FFPROBE_PATH):
        return audio_tracks
    try:
        hdr = f'User-Agent: {USER_AGENT}\r\n'
        if referer:
            hdr += f'Referer: {referer}\r\n'
        cmd = [
            FFPROBE_PATH, '-v', 'quiet',
            '-print_format', 'json',
            '-show_streams',
            '-probesize', '4000000',
            '-analyzeduration', '3000000',
            '-headers', hdr,
            stream_url
        ]
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, _ = p.communicate(timeout=10)
        data = json.loads(out)
        default_lang_order = ['Hindi', 'Tamil', 'Telugu', 'Kannada', 'Malayalam']
        track_counter = 1
        for s in data.get('streams', []):
            if s.get('codec_type') == 'audio':
                tags = s.get('tags', {})
                raw_lang  = tags.get('language', 'und').lower()
                raw_title = tags.get('title', '')
                if any(k in raw_title.lower() for k in ['hdhub4u', 'hubcloud', 'uploaded', '4khdhub']):
                    lang_name = LANG_MAP.get(raw_lang)
                else:
                    lang_name = raw_title or LANG_MAP.get(raw_lang)
                if not lang_name or lang_name == 'Audio Track':
                    lang_name = default_lang_order[track_counter - 1] if track_counter <= len(default_lang_order) else f"Track {track_counter}"
                codec    = s.get('codec_name', '').upper()
                channels = s.get('channels', 2)
                ch_str   = "5.1" if channels == 6 else ("7.1" if channels == 8 else "Stereo")
                audio_tracks.append({
                    "track_num":    track_counter,
                    "stream_index": s.get('index'),
                    "lang":         lang_name,
                    "codec":        codec,
                    "channels":     ch_str,
                    "label":        f"Track {track_counter}: {lang_name} ({codec} {ch_str})"
                })
                track_counter += 1
    except Exception as e:
        print("[Audio Probe] error:", e)
    return audio_tracks

# ── Main Link Resolver ─────────────────────────────────────────────────────────

def resolve_hubcloud(input_url):
    try:
        if not input_url.startswith('http'):
            return {"success": False, "error": "Invalid URL — http/https se shuru hona chahiye"}

        html, current_url = fetch_html(input_url)

        # Title and file size detection
        title_m = re.search(r'<title>(.*?)</title>', html, re.I)
        movie_title = title_m.group(1).strip() if title_m else "Movie Stream"
        movie_title = re.sub(
            r'\s*[-|]\s*(HDHub4u|4KHDHub|HubCloud|HubDrive|StreamHub|Watch Online|Free Download).*',
            '', movie_title, flags=re.I
        ).strip()
        size_m = re.search(r'([\d.,]+\s*(?:GB|MB|KB))', html, re.I)
        file_size = size_m.group(1).strip() if size_m else "Unknown Size"

        # Step 1: Follow HubDrive -> HubCloud
        m_hubcloud = re.search(r'href=["\'](https?://hubcloud\.[a-z]+/drive/[^"\'\s]+)["\']', html)
        if m_hubcloud and '/drive/admin' not in m_hubcloud.group(1):
            target_hubcloud = m_hubcloud.group(1)
            print(f"[Resolver] Followed HubDrive to: {target_hubcloud}")
            html, current_url = fetch_html(target_hubcloud, referer=input_url)

        # Step 2: Follow HubCloud -> GamerXYT
        m_gamer = re.search(r'href=["\'](https?://gamerxyt\.com/hubcloud\.php[^"\'\s]+)["\']', html)
        if m_gamer:
            gamer_url = m_gamer.group(1).replace('&amp;', '&')
            print(f"[Resolver] Followed HubCloud to GamerXYT: {gamer_url[:60]}")
            html, current_url = fetch_html(gamer_url, referer=current_url)

        # Step 3: Discover all mirror links and test liveness
        mirrors = []
        seen_urls = set()

        # A. Check for GPDL link (Google 10Gbps CDN)
        m_gpdl = re.search(r'href=["\'](https?://gpdl\.hubcloud\.[a-z]+/\?[^"\']+)["\']', html)
        if m_gpdl:
            gpdl_url = m_gpdl.group(1).replace('&amp;', '&')
            print("[Resolver] Found GPDL server, resolving to Google CDN...")
            direct_g = resolve_gpdl(gpdl_url, referer=current_url)
            if direct_g and direct_g not in seen_urls:
                seen_urls.add(direct_g)
                alive = check_link_alive(direct_g)
                mirrors.append({
                    'name': '[10Gbps] Google High-Speed Server',
                    'url': direct_g,
                    'alive': alive,
                    'type': 'google_cdn'
                })
                print(f"  -> Google CDN stream: {'ACTIVE [OK]' if alive else 'OFFLINE [FAIL]'}")

        # B. Check for R2 Cloudflare storage links
        for m in re.finditer(r'href=["\'](https?://[a-z0-9]+\.r2\.cloudflarestorage\.com/[^"\']+)["\']', html):
            r2_url = m.group(1).replace('&amp;', '&')
            if r2_url not in seen_urls:
                seen_urls.add(r2_url)
                alive = check_link_alive(r2_url)
                status_note = ' (ACTIVE [OK])' if alive else ' (Cloudflare R2 Disabled / 403)'
                mirrors.append({
                    'name': f'Cloudflare FSL Server{status_note}',
                    'url': r2_url,
                    'alive': alive,
                    'type': 'r2'
                })
                print(f"  -> R2 link: {'ACTIVE [OK]' if alive else 'DEAD (403)'}")

        # C. Check for direct video links (.mkv, .mp4)
        for m in re.finditer(r'href=["\'](https?://[^"\']+\.(?:mkv|mp4|m3u8)(?:\?[^"\']*)?)["\']', html):
            vid_url = m.group(1).replace('&amp;', '&')
            if vid_url not in seen_urls:
                seen_urls.add(vid_url)
                alive = check_link_alive(vid_url)
                mirrors.append({
                    'name': 'Direct Video Stream' + (' (ACTIVE [OK])' if alive else ' (OFFLINE)'),
                    'url': vid_url,
                    'alive': alive,
                    'type': 'direct'
                })

        # D. Check for watch online player links (hbplay)
        watch_online_url = None
        for m in re.finditer(r'href=["\'](https?://hbplay\.[^"\']+)["\']', html):
            watch_online_url = m.group(1).replace('&amp;', '&')
            break

        # Pick best working stream
        working_mirrors = [m for m in mirrors if m['alive']]
        best_stream_url = working_mirrors[0]['url'] if working_mirrors else (mirrors[0]['url'] if mirrors else None)

        if not best_stream_url:
            return {
                "success": False,
                "error": "Koi working stream link nahi mila. Server structure change hua ho sakta hai."
            }

        # Audio probe on the working stream
        audio_tracks = probe_audio_tracks(best_stream_url)

        return {
            "success":          True,
            "title":            movie_title,
            "size":             file_size,
            "stream_url":       best_stream_url,
            "audio_tracks":     audio_tracks,
            "watch_online_url": watch_online_url,
            "mirrors":          mirrors
        }

    except Exception as e:
        return {"success": False, "error": str(e)}

# ── HDHub4u Search & Details ───────────────────────────────────────────────────

HDHUB4U_BASE_URL   = "https://new10.hdhub4u.cl/"
HDHUB4U_SEARCH_API = "https://search.pingora.fyi/collections/post/documents/search"

def search_hdhub4u(query):
    results = []
    try:
        api_url = (
            f'{HDHUB4U_SEARCH_API}?q={urllib.parse.quote(query)}'
            f'&query_by=post_title,category,stars,director,imdb_id'
            f'&query_by_weights=4,2,2,2,4&sort_by=sort_by_date:desc&limit=15'
        )
        req = urllib.request.Request(api_url, headers={
            'User-Agent': USER_AGENT,
            'Referer': HDHUB4U_BASE_URL,
            'Origin': 'https://new10.hdhub4u.cl',
        })
        with urllib.request.urlopen(req, timeout=12) as r:
            data = json.loads(r.read().decode())
            for h in data.get('hits', [])[:10]:
                doc       = h.get('document', {})
                title     = doc.get('post_title', '').replace(' &#038;', ' &').replace(' &#8211;', '-')
                permalink = doc.get('permalink', '')
                thumbnail = doc.get('post_thumbnail', '')
                if permalink:
                    permalink = re.sub(
                        r'https?://(?:new\d+|www)?\.hdhub4u\.[a-z]+',
                        HDHUB4U_BASE_URL.rstrip('/'),
                        permalink
                    )
                    if not permalink.startswith('http'):
                        permalink = urllib.parse.urljoin(HDHUB4U_BASE_URL, permalink)
                if title and permalink:
                    results.append({'title': title, 'permalink': permalink, 'thumbnail': thumbnail})
    except Exception as e:
        print("[HDHub4u Search] error:", e)
    return results

def parse_movie_details(post_url):
    details = {"title": "", "poster": "", "qualities": []}
    try:
        post_url = re.sub(
            r'https?://(?:new\d+|www)?\.hdhub4u\.[a-z]+',
            HDHUB4U_BASE_URL.rstrip('/'),
            post_url
        )
        html, _ = fetch_html(post_url, referer=HDHUB4U_BASE_URL)

        t_m = re.search(r'<title>(.*?)</title>', html, re.I)
        details['title'] = re.sub(
            r'\s*-\s*(HDHub4u Official|4KHDHub|Watch Online|Free Download).*', '',
            t_m.group(1) if t_m else '', flags=re.I
        ).replace(' &#038;', ' &').replace(' &#8211;', '-').strip()

        img_m = re.search(r'<meta property="og:image" content="([^"]+)"', html)
        details['poster'] = img_m.group(1) if img_m else ''

        links = re.findall(
            r'<a[^>]+href=["\'](https?://(?:hubdrive|hubcloud|hubcdn|drive|4khdhub|hub4drive)[^"\']+)["\'][^>]*>(.*?)</a>',
            html, re.DOTALL | re.I
        )
        for l_url, l_text in links:
            clean_text = re.sub(r'<[^>]+>', '', l_text).strip()
            path_part = urllib.parse.urlparse(l_url).path
            if len(path_part) <= 2:
                continue
            if not clean_text or clean_text.lower() in ['download', 'click here', 'watch', '4k movies', 'join telegram']:
                continue
            details['qualities'].append({'title': clean_text, 'link': l_url})

    except Exception as e:
        print("[Movie Details] error:", e)
    return details

