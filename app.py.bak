    <!-- Search Section -->
    <div class="card">
        <h2 style="font-size:1.05rem;margin-bottom:12px">🎬 Search Movies &amp; Series (new10.hdhub4u.cl)</h2>
        <div class="input-row">
            <input type="text" id="searchInput" placeholder="Movie ya web-series ka naam likhein..." onkeydown="if(event.key==='Enter') searchMovie()">
            <button class="btn-primary" onclick="searchMovie()">Search</button>
        </div>
        <div class="status-msg" id="searchStatus"></div>
        <div class="search-grid" id="searchGrid"></div>
    </div>

    <!-- Movie Qualities Card -->
    <div class="card" id="qualitiesCard" style="display:none">
        <h3 id="movieCardTitle" style="font-size:1.1rem;margin-bottom:10px"></h3>
        <label style="font-size:0.85rem;color:var(--text-sub)">Quality / Language choose karein:</label>
        <div style="display:flex;gap:10px;margin-top:8px;flex-wrap:wrap">
            <select id="qualitySelect" style="flex:1;min-width:200px;padding:12px;background:#0b0f19;color:#fff;border:1px solid #374151;border-radius:8px;"></select>
            <button class="btn-primary" onclick="useSelectedQuality()">Use This Quality</button>
        </div>
    </div>

    <!-- Direct URL Input Card -->
    <div class="card">
        <h2 style="font-size:1.05rem;margin-bottom:12px">🔗 Paste Any Link Directly</h2>
        <div class="input-row">
            <input type="text" id="urlInput" placeholder="hubcloud.ist / hubdrive / 4khdhub / hdhub4u link paste karein...">
            <button class="btn-primary" id="btnResolve" onclick="resolveLink()">⚡ Resolve &amp; Stream</button>
        </div>
        <div class="status-msg" id="resolveStatus">⏳ Resolving link, checking active servers...</div>
        <div id="errorBox" class="error-box" style="display:none"></div>
    </div>

    <!-- Results Section -->
    <div class="card" id="resultsCard" style="display:none">
        <h2 id="resTitle" style="font-size:1.25rem;font-weight:700;margin-bottom:8px"></h2>
        <div class="badge-row">
            <span class="badge" id="resSize">📦 Size: —</span>
            <span class="badge badge-green" id="resStatusBadge">🟢 Stream Verified Active</span>
            <span class="badge" id="resTrackBadge">🔊 Audio: Multi-Audio</span>
        </div>

        <!-- Big VLC Button -->
        <button class="vlc-banner" onclick="launchVlcCurrent()">
            ▶️ Play in VLC Player (Instant 4K Playback)
        </button>

        <div style="margin-top:16px">
            <label style="font-size:0.88rem;font-weight:700">Audio Track (VLC Audio Language):</label>
            <select id="audioTrackSelect" class="audio-select">
                <option value="1">Track 1: Hindi / Default</option>
                <option value="2">Track 2: English / Second Audio</option>
                <option value="3">Track 3: Tamil / Telugu / Regional</option>
            </select>
        </div>

        <div class="tip-box">
            💡 <b>Fixed &amp; Verified:</b> Dead Cloudflare R2 links (403 NotEntitled) ko skip karke high-speed Google CDN stream automatically select ho gaya hai. VLC mein bina kisi error ke instantly chalega!
        </div>

        <!-- Detected Mirrors -->
        <div class="mirrors-list">
            <h3 style="font-size:0.95rem;color:var(--text-sub);margin-bottom:10px;text-transform:uppercase;letter-spacing:0.5px">Detected Mirrors &amp; Servers</h3>
            <div id="mirrorsContainer"></div>
        </div>
    </div>
</div>

<script>
    let activeStreamUrl = "";

    async function searchMovie() {
        const query = document.getElementById('searchInput').value.trim();
        const status = document.getElementById('searchStatus');
        const grid = document.getElementById('searchGrid');
        if (!query) { status.style.display = 'block'; status.innerText = 'Movie ka naam likhein.'; return; }
        status.style.display = 'block';
        status.innerText = '🔍 Searching HDHub4u...';
        grid.innerHTML = '';
        try {
            const resp = await fetch('/api/search?q=' + encodeURIComponent(query));
            const data = await resp.json();
            if (!data.length) { status.innerText = 'Koi result nahi mila.'; return; }
            status.innerText = `${data.length} results mile — movie select karein:`;
            data.forEach(m => {
                const card = document.createElement('div');
                card.className = 'movie-card';
                card.innerHTML = `
                    <img src="${m.thumbnail || ''}" alt="">
                    <div>${m.title}</div>
                `;
                card.onclick = () => loadMovieDetails(m);
                grid.appendChild(card);
            });
        } catch (e) {
            status.innerText = 'Search error: ' + e.message;
        }
    }

    async function loadMovieDetails(movie) {
        const panel = document.getElementById('qualitiesCard');
        const title = document.getElementById('movieCardTitle');
        const select = document.getElementById('qualitySelect');
        title.innerText = movie.title;
        panel.style.display = 'block';
        select.innerHTML = '<option>Loading qualities...</option>';
        try {
            const resp = await fetch('/api/movie?url=' + encodeURIComponent(movie.permalink));
            const details = await resp.json();
            select.innerHTML = '';
            if (!details.qualities || !details.qualities.length) {
                select.innerHTML = '<option>Koi quality links nahi mile</option>';
                return;
            }
            details.qualities.forEach(q => {
                const opt = document.createElement('option');
                opt.value = q.link;
                opt.textContent = q.title;
                select.appendChild(opt);
            });
        } catch (e) {
            select.innerHTML = '<option>Error loading qualities</option>';
        }
    }

    function useSelectedQuality() {
        const select = document.getElementById('qualitySelect');
        if (!select.value) return;
        document.getElementById('urlInput').value = select.value;
        resolveLink();
    }

    async function resolveLink() {
        const url = document.getElementById('urlInput').value.trim();
        if (!url) { alert('Pehle link paste karein!'); return; }
        const status = document.getElementById('resolveStatus');
        const errBox = document.getElementById('errorBox');
        const btn = document.getElementById('btnResolve');
        const resCard = document.getElementById('resultsCard');

        status.style.display = 'block';
        status.innerText = '⏳ Resolving server links and verifying stream...';
        errBox.style.display = 'none';
        btn.disabled = true;
        resCard.style.display = 'none';

        try {
            const resp = await fetch('/api/resolve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url })
            });
            const data = await resp.json();
            btn.disabled = false;

            if (!data.success) {
                status.style.display = 'none';
                errBox.style.display = 'block';
                errBox.innerHTML = '❌ <b>Error:</b> ' + (data.error || 'Link resolve nahi hua');
                return;
            }

            status.style.display = 'none';
            resCard.style.display = 'block';
            document.getElementById('resTitle').innerText = data.title;
            document.getElementById('resSize').innerText = '📦 ' + (data.size || 'HD Video');

            activeStreamUrl = data.stream_url;

            // Audio tracks
            const audioSelect = document.getElementById('audioTrackSelect');
            if (data.audio_tracks && data.audio_tracks.length) {
                audioSelect.innerHTML = '';
                data.audio_tracks.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.track_num;
                    opt.textContent = t.label;
                    audioSelect.appendChild(opt);
                });
            }

            // Render Mirrors
            const mirrorsContainer = document.getElementById('mirrorsContainer');
            mirrorsContainer.innerHTML = '';
            (data.mirrors || []).forEach(m => {
                const item = document.createElement('div');
                item.className = 'mirror-item' + (m.url === activeStreamUrl ? ' active' : '');
                item.innerHTML = `
                    <div class="mirror-name">
                        ${m.alive ? '🟢' : '🔴'} <b>${m.name}</b>
                    </div>
                    <div class="mirror-actions">
                        <button class="btn-sm btn-vlc-sm" onclick="playInVlcCustom('${encodeURIComponent(m.url)}')">▶️ Play in VLC</button>
                        <button class="btn-sm btn-copy-sm" onclick="copyCustomUrl('${encodeURIComponent(m.url)}')">📋 Copy</button>
                    </div>
                `;
                mirrorsContainer.appendChild(item);
            });

        } catch (e) {
            btn.disabled = false;
            status.style.display = 'none';
            errBox.style.display = 'block';
            errBox.innerHTML = '❌ Network error: ' + e.message;
        }
    }

    async function launchVlcCurrent() {
        if (!activeStreamUrl) { alert('Pehle link resolve karein!'); return; }
        const track = document.getElementById('audioTrackSelect').value || 1;
        playInVlcCustom(encodeURIComponent(activeStreamUrl), track);
    }

    async function playInVlcCustom(encodedUrl, track) {
        const url = decodeURIComponent(encodedUrl);
        const trk = track || document.getElementById('audioTrackSelect').value || 1;
        try {
            const resp = await fetch('/api/play_vlc', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ stream_url: url, audio_track: parseInt(trk) })
            });
            const data = await resp.json();
            if (data.success) {
                alert('🚀 VLC Player launch ho gaya! Stream chal raha hai.');
            } else {
                alert('⚠️ VLC Error: ' + (data.message || 'VLC open nahi hua'));
            }
        } catch (e) {
            alert('Error: ' + e.message);
        }
    }

    function copyCustomUrl(encodedUrl) {
        const url = decodeURIComponent(encodedUrl);
        navigator.clipboard.writeText(url).then(() => {
            alert('✅ Stream URL copy ho gaya!');
        });
    }
</script>
</body>
</html>"""

# ── HTTP Server Request Handler ────────────────────────────────────────────────

class RequestHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        if args and str(args[1]) not in ('200', '304'):
            super().log_message(fmt, *args)

    def do_HEAD(self):
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        qp     = urllib.parse.parse_qs(parsed.query)
        path   = parsed.path

        # Search API
        if path == '/api/search':
            q = qp.get('q', [''])[0]
            self._json(search_hdhub4u(q))
            return

        # Movie Details API
        if path == '/api/movie':
            url = qp.get('url', [''])[0]
            self._json(parse_movie_details(url))
            return

        # Local Range-enabled Streaming Proxy
        if path.startswith('/api/proxy/'):
            key = path.split('/api/proxy/')[-1].strip('/')
            with _proxy_lock:
                entry = _proxy_cache.get(key)
            if not entry:
                self.send_response(404); self.end_headers()
                self.wfile.write(b'Proxy key not found'); return
            real_url = entry['url']
            referer  = entry.get('referer', '')
            range_hdr = self.headers.get('Range', '')
            headers = {
                'User-Agent': USER_AGENT,
                'Accept': '*/*',
                'Connection': 'keep-alive',
            }
            if referer:   headers['Referer'] = referer
            if range_hdr: headers['Range']   = range_hdr
            try:
                req = urllib.request.Request(real_url, headers=headers)
                with urllib.request.urlopen(req, timeout=30) as r:
                    self.send_response(r.status)
                    self.send_header('Content-Type', r.headers.get('Content-Type', 'video/x-matroska'))
                    self.send_header('Accept-Ranges', r.headers.get('Accept-Ranges', 'bytes'))
                    self.send_header('Access-Control-Allow-Origin', '*')
                    cl = r.headers.get('Content-Length', '')
                    cr = r.headers.get('Content-Range', '')
                    if cl: self.send_header('Content-Length', cl)
                    if cr: self.send_header('Content-Range', cr)
                    self.end_headers()
                    while True:
                        chunk = r.read(256 * 1024)
                        if not chunk: break
                        try:
                            self.wfile.write(chunk)
                            self.wfile.flush()
                        except (BrokenPipeError, ConnectionResetError):
                            break
            except Exception as e:
                try: self.send_response(502); self.end_headers(); self.wfile.write(str(e).encode())
                except Exception: pass
            return

        # Frontend App
        if path in ('/', '/index.html'):
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write(HTML_PAGE.encode('utf-8'))
            return

        self.send_response(404); self.end_headers()

    def do_POST(self):
        length = int(self.headers.get('Content-Length', 0))
        raw_body = self.rfile.read(length)

        # Resolve API
        if self.path == '/api/resolve':
            try:
                body = json.loads(raw_body.decode('utf-8'))
                target_url = body.get('url', '')
                res = resolve_hubcloud(target_url)
                self._json(res)
            except Exception as e:
                self._json({"success": False, "error": str(e)}, status=500)
            return

        # VLC Player Launch API
        if self.path == '/api/play_vlc':
            try:
                body        = json.loads(raw_body.decode('utf-8'))
                stream_url  = body.get('stream_url', '')
                audio_track = body.get('audio_track', 1)

                if not stream_url:
                    self._json({"success": False, "message": "Stream URL missing"})
                    return

                if not os.path.exists(VLC_PATH):
                    self._json({"success": False, "message": f"VLC player nahi mila at {VLC_PATH}"})
                    return

                subprocess.Popen([
                    VLC_PATH,
                    stream_url,
                    '--network-caching=3000',
                    '--http-reconnect',
                    f'--audio-track={max(0, audio_track - 1)}'
                ])
                self._json({"success": True, "message": "VLC successfully launched!"})
            except Exception as e:
                self._json({"success": False, "error": str(e)}, status=500)
            return

        self.send_response(404); self.end_headers()

    def _json(self, data, status=200):
        body = json.dumps(data, ensure_ascii=False).encode('utf-8')
        self.send_response(status)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

class ThreadedTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads      = True

def run():
    print("=" * 55)
    print("       StreamHub Movie Streamer v4.5 — Final Fix")
    print("=" * 55)
    print(f"  VLC Player : {'FOUND [OK] (' + VLC_PATH + ')' if os.path.exists(VLC_PATH) else 'NOT FOUND'}")
    print(f"  Server URL : http://localhost:{PORT}")
    print("=" * 55)
    webbrowser.open(f"http://localhost:{PORT}")
    with ThreadedTCPServer(("", PORT), RequestHandler) as httpd:
        print(f"\n  Ready at http://localhost:{PORT}\n")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\nServer stopped.")

if __name__ == '__main__':
    run()
