                    audio_track: trk,
                    sub_track: subEl ? subEl.value : 'auto',
                    media_key: pKey ? `${pKey}::ep::${nxt.ep_label || (activeSeriesEpIdx + 1)}` : nxt.link,
                    parent_key: pKey,
                };
            }
        }
        return null;
    }

