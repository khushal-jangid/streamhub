    transition: transform 0.15s, border-color 0.15s;
}
.movie-card:hover { transform: translateY(-3px); border-color: var(--accent); }
.movie-card img { width: 100%; aspect-ratio: 2/3; object-fit: cover; background: #1e293b; }
.movie-card div { padding: 8px 10px; font-size: 0.8rem; font-weight: 600; line-height: 1.35; }
.status-msg { margin-top: 14px; font-size: 0.9rem; color: var(--text-sub); display: none; text-align: center; }
.error-box {
    background: rgba(239, 68, 68, 0.12);
    border: 1px solid rgba(239, 68, 68, 0.35);
    border-radius: 10px;
    padding: 14px;
    margin-top: 14px;
    font-size: 0.88rem;
    color: #fca5a5;
    line-height: 1.5;
}
.badge-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px; }
.badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(99, 102, 241, 0.15);
    color: #a5b4fc;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
}
.badge-green { background: rgba(16, 185, 129, 0.15); color: #6ee7b7; }
.badge-netflix { background: rgba(229, 9, 20, 0.2); color: #ff6b6b; border: 1px solid rgba(229, 9, 20, 0.4); }
.badge-red { background: rgba(239, 68, 68, 0.15); color: #fca5a5; }
.vlc-banner {
    background: linear-gradient(135deg, #ea580c, #c2410c);
    color: white;
    border: none;
    padding: 16px;
    border-radius: 12px;
    font-size: 1.1rem;
    font-weight: 800;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-shadow: 0 4px 18px rgba(234, 88, 12, 0.4);
    margin-top: 14px;
    transition: transform 0.1s, opacity 0.15s;
}
.vlc-banner:hover { opacity: 0.92; transform: scale(1.01); }
.vlc-banner:active { transform: scale(0.99); }
.btn-watch-online {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    color: white;
    border: none;
    padding: 14px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 10px;
    text-decoration: none;
    transition: opacity 0.15s;
    box-sizing: border-box;
}
.btn-watch-online:hover { opacity: 0.92; }
.btn-playlist {
    background: #1e293b;
    color: #e2e8f0;
    border: 1px solid var(--border);
    padding: 13px;
    border-radius: 12px;
    font-size: 0.92rem;
    font-weight: 700;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 10px;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
    box-sizing: border-box;
}
.btn-playlist:hover { background: #334155; color: #fff; }
.btn-copy-stream {
    background: #1e293b;
    color: #cbd5e1;
    border: 1px solid var(--border);
    padding: 12px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 8px;
    transition: background 0.15s;
}
.btn-copy-stream:hover { background: #334155; color: #fff; }
.mirrors-list { margin-top: 20px; }
.mirror-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: #0f172a;
    border: 1px solid var(--border);
    border-radius: 10px;
    margin-bottom: 8px;
    gap: 10px;
    flex-wrap: wrap;
}
.mirror-item.active { border-color: var(--accent); background: #151d30; }
.mirror-name { font-weight: 600; font-size: 0.88rem; flex: 1; min-width: 200px; }
.mirror-actions { display: flex; gap: 8px; }
.btn-sm {
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.78rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: background 0.15s;
}
.btn-vlc-sm { background: #ea580c; color: white; }
.btn-vlc-sm:hover { background: #c2410c; }
.btn-copy-sm { background: #334155; color: #f1f5f9; }
.btn-copy-sm:hover { background: #475569; }
.audio-select {
    width: 100%;
    padding: 10px 14px;
    border-radius: 8px;
    background: #0b0f19;
    color: #fff;
    border: 1px solid #374151;
    font-size: 0.9rem;
    outline: none;
    margin-top: 8px;
}
.tip-box {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 10px;
    padding: 12px 14px;
    margin-top: 16px;
    font-size: 0.83rem;
    color: #6ee7b7;
    line-height: 1.5;
}
</style>
</head>
<body>
<div class="container">
    <header>
        <h1>⚡ StreamHub</h1>
        <p>HDHub4u &bull; HubCloud &bull; HubDrive &bull; 4KHDHub — Zero-Lag VLC &amp; Browser Streaming</p>
    </header>

    <!-- Search Section -->
    <div class="card">
        <h2 style="font-size:1.05rem;margin-bottom:12px">🎬 Search Movies &amp; Series (new10.hdhub4u.cl)</h2>
        <div class="input-row">
            <input type="text" id="searchInput" placeholder="Movie ya web-series ka naam likhein..." onkeydown="if(event.key==='Enter') searchMovie()">
            <button class="btn-primary" onclick="searchMovie()">Search</button>
        </div>
        <div class="status-msg" id="searchStatus"></div>
        <div class="search-grid" id="searchGrid"></div>
    </div>

    <!-- Movie Qualities Card -->
    <div class="card" id="qualitiesCard" style="display:none">
        <h3 id="movieCardTitle" style="font-size:1.1rem;margin-bottom:10px"></h3>
        <label style="font-size:0.85rem;color:var(--text-sub)">Quality / Language choose karein:</label>
        <div style="display:flex;gap:10px;margin-top:8px;flex-wrap:wrap">
            <select id="qualitySelect" style="flex:1;min-width:200px;padding:12px;background:#0b0f19;color:#fff;border:1px solid #374151;border-radius:8px;"></select>
            <button class="btn-primary" onclick="useSelectedQuality()">Use This Quality</button>
        </div>
    </div>

    <!-- Direct URL Input Card -->
    <div class="card">
        <h2 style="font-size:1.05rem;margin-bottom:12px">🔗 Paste Any Link Directly</h2>
        <div class="input-row">
            <input type="text" id="urlInput" placeholder="hubcloud.ist / hubdrive / 4khdhub / hdhub4u / hdstream4u link paste karein...">
            <button class="btn-primary" id="btnResolve" onclick="resolveLink()">⚡ Resolve &amp; Stream</button>
        </div>
        <div class="status-msg" id="resolveStatus">⏳ Resolving Netflix Mode HLS &amp; High-Speed Servers...</div>
        <div id="errorBox" class="error-box" style="display:none"></div>
    </div>

    <!-- Results Section -->
    <div class="card" id="resultsCard" style="display:none">
        <h2 id="resTitle" style="font-size:1.25rem;font-weight:700;margin-bottom:8px"></h2>
        <div class="badge-row">
            <span class="badge" id="resSize">📦 Size: —</span>
            <span class="badge badge-green" id="resStatusBadge">🟢 Stream Verified Active</span>
            <span class="badge badge-netflix" id="resNetflixBadge">⚡ Netflix Mode (Instant Seek)</span>
            <span class="badge" id="resTrackBadge">🔊 Audio: Hindi / Multi</span>
        </div>

        <!-- Big VLC Button -->
        <button class="vlc-banner" onclick="launchVlcCurrent()">
            ▶️ Play in VLC Player (Instant 1-Click Launch)
        </button>

        <!-- Open via VLC Playlist File -->
        <a id="btnDownloadPlaylist" class="btn-playlist" href="#" download="streamhub.m3u8">
            📥 Open via VLC Playlist File (.m3u8 — 100% Reliable Playback)
        </a>

        <!-- Watch Online Player Link -->
        <a id="btnWatchOnline" class="btn-watch-online" target="_blank" href="#" style="display:none;">
            🌐 Watch Online in Browser (HTML5 Player with Full Seekbar)
        </a>

        <!-- Copy Stream URL Button -->
        <button class="btn-copy-stream" onclick="copyActiveStreamUrl()">
            📋 Copy Direct Stream Link (For IDM / MX Player / PotPlayer)
        </button>

        <div style="margin-top:16px">
            <label style="font-size:0.88rem;font-weight:700">Audio Track (VLC Audio Language):</label>
            <select id="audioTrackSelect" class="audio-select">
                <option value="1">Track 1: Hindi / Default</option>
                <option value="2">Track 2: English / Second Audio</option>
                <option value="3">Track 3: Tamil / Telugu / Regional</option>
            </select>
        </div>

        <div class="tip-box">
            💡 <b>Netflix Mode Active:</b> Adaptive HLS stream auto-selected! Seekbar scrub (aage/piche) instant chalega bina ruke ya freeze huye — exactly like Netflix! VLC aur Browser Player dono mein smooth playback chalega.
        </div>

        <!-- Detected Mirrors -->
        <div class="mirrors-list">
            <h3 style="font-size:0.95rem;color:var(--text-sub);margin-bottom:10px;text-transform:uppercase;letter-spacing:0.5px">Detected Mirrors &amp; Servers</h3>
            <div id="mirrorsContainer"></div>
        </div>
    </div>
</div>

<script>
    let activeStreamUrl = "";

    async function searchMovie() {
        const query = document.getElementById('searchInput').value.trim();
        const status = document.getElementById('searchStatus');
        const grid = document.getElementById('searchGrid');
        if (!query) { status.style.display = 'block'; status.innerText = 'Movie ka naam likhein.'; return; }
        status.style.display = 'block';
        status.innerText = '🔍 Searching HDHub4u...';
        grid.innerHTML = '';
        try {
            const resp = await fetch('/api/search?q=' + encodeURIComponent(query));
            const data = await resp.json();
            if (!data.length) { status.innerText = 'Koi result nahi mila.'; return; }
            status.innerText = `${data.length} results mile — movie select karein:`;
            data.forEach(m => {
                const card = document.createElement('div');
                card.className = 'movie-card';
                card.innerHTML = `
                    <img src="${m.thumbnail || ''}" alt="">
                    <div>${m.title}</div>
                `;
                card.onclick = () => loadMovieDetails(m);
                grid.appendChild(card);
            });
        } catch (e) {
            status.innerText = 'Search error: ' + e.message;
        }
    }

    async function loadMovieDetails(movie) {
        const panel = document.getElementById('qualitiesCard');
        const title = document.getElementById('movieCardTitle');
        const select = document.getElementById('qualitySelect');
        title.innerText = movie.title;
        panel.style.display = 'block';
        select.innerHTML = '<option>Loading qualities...</option>';
        try {
            const resp = await fetch('/api/movie?url=' + encodeURIComponent(movie.permalink));
            const details = await resp.json();
            select.innerHTML = '';
            if (!details.qualities || !details.qualities.length) {
                select.innerHTML = '<option>Koi quality links nahi mile</option>';
                return;
            }
            details.qualities.forEach(q => {
                const opt = document.createElement('option');
                opt.value = q.link;
                opt.textContent = q.title;
                select.appendChild(opt);
            });
        } catch (e) {
            select.innerHTML = '<option>Error loading qualities</option>';
        }
    }

    function useSelectedQuality() {
        const select = document.getElementById('qualitySelect');
        if (!select.value) return;
        document.getElementById('urlInput').value = select.value;
        resolveLink();
    }

    async function resolveLink() {
        const url = document.getElementById('urlInput').value.trim();
        if (!url) { alert('Pehle link paste karein!'); return; }
        const status = document.getElementById('resolveStatus');
        const errBox = document.getElementById('errorBox');
        const btn = document.getElementById('btnResolve');
        const resCard = document.getElementById('resultsCard');

        status.style.display = 'block';
        status.innerText = '⏳ Resolving Netflix Mode HLS & High-Speed Servers...';
        errBox.style.display = 'none';
        btn.disabled = true;
        resCard.style.display = 'none';

        try {
            const resp = await fetch('/api/resolve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ url })
            });
            const data = await resp.json();
            btn.disabled = false;

            if (!data.success) {
                status.style.display = 'none';
                errBox.style.display = 'block';
                errBox.innerHTML = '❌ <b>Error:</b> ' + (data.error || 'Link resolve nahi hua');
                return;
            }

            status.style.display = 'none';
            resCard.style.display = 'block';
            document.getElementById('resTitle').innerText = data.title;
            document.getElementById('resSize').innerText = '📦 ' + (data.size || 'HD Video');

            const is4K = /4k|2160p|60fps|bluray/i.test(data.title);
            const isHls = data.stream_url && data.stream_url.indexOf('.m3u8') !== -1;
            const netflixBadge = document.getElementById('resNetflixBadge');
            if (netflixBadge) {
                if (is4K) {
                    netflixBadge.className = 'badge badge-green';
                    netflixBadge.innerText = '💎 True 4K Ultra HD (Original File)';
                } else if (isHls) {
                    netflixBadge.className = 'badge badge-netflix';
                    netflixBadge.innerText = '⚡ Fast HLS Stream';
                } else {
                    netflixBadge.className = 'badge badge-green';
                    netflixBadge.innerText = '🟢 Direct High-Speed Stream';
                }
            }
            const trackBadge = document.getElementById('resTrackBadge');
            if (trackBadge) {
                if (data.audio_tracks && data.audio_tracks.length) {
                    trackBadge.innerText = `🔊 Audio: ${data.audio_tracks.length} Tracks Available`;
                } else {
                    trackBadge.innerText = '🔊 Audio: Multi-Audio';
                }
            }
            const vlcBanner = document.querySelector('.vlc-banner');
            if (vlcBanner) {
                if (is4K) {
                    vlcBanner.innerHTML = '💎 <b>Original 4K 60FPS Stream Ready:</b> 10Gbps Google High-Speed Server se direct 4K video load ho gaya hai bina kisi quality downscaling ke! "Play in VLC" click karein ya .m3u8 playlist VLC mein open karein.';
                } else {
                    vlcBanner.innerHTML = '⚡ <b>High-Speed Stream Ready:</b> Direct server link select ho gaya hai. VLC Player mein bina kisi delay ke full quality chalega.';
                }
            }

            activeStreamUrl = data.stream_url;

            // Playlist button
            const btnPl = document.getElementById('btnDownloadPlaylist');
            if (btnPl) {
                btnPl.href = `/api/playlist.m3u8?url=${encodeURIComponent(data.stream_url)}&t=${encodeURIComponent(data.title)}`;
            }

            // Watch Online Button
            const btnOnline = document.getElementById('btnWatchOnline');
            if (data.watch_online_url) {
                btnOnline.href = data.watch_online_url;
                btnOnline.style.display = 'flex';
            } else {
                btnOnline.style.display = 'none';
            }

            // Audio tracks
            const audioSelect = document.getElementById('audioTrackSelect');
            if (data.audio_tracks && data.audio_tracks.length) {
                audioSelect.innerHTML = '';
                data.audio_tracks.forEach(t => {
                    const opt = document.createElement('option');
                    opt.value = t.track_num;
                    opt.textContent = t.label;
                    audioSelect.appendChild(opt);
                });
            }

            // Render Mirrors
            const mirrorsContainer = document.getElementById('mirrorsContainer');
            mirrorsContainer.innerHTML = '';
            (data.mirrors || []).forEach(m => {
                const item = document.createElement('div');
                item.className = 'mirror-item' + (m.url === activeStreamUrl ? ' active' : '');
                const vlcBtn = m.alive
                    ? `<button class="btn-sm btn-vlc-sm" onclick="playInVlcCustom('${encodeURIComponent(m.url)}')">▶️ Play in VLC</button>`
                    : `<button class="btn-sm" style="background:#334155;color:#94a3b8;cursor:not-allowed;" disabled title="Server offline (403)">❌ Offline (403)</button>`;

                item.innerHTML = `
                    <div class="mirror-name">
                        ${m.alive ? '🟢' : '🔴'} <b>${m.name}</b>
                    </div>
                    <div class="mirror-actions">
                        ${vlcBtn}
                        <button class="btn-sm btn-copy-sm" onclick="copyCustomUrl('${encodeURIComponent(m.url)}')">📋 Copy</button>
                    </div>
                `;
                mirrorsContainer.appendChild(item);
            });

        } catch (e) {
            btn.disabled = false;
            status.style.display = 'none';
            errBox.style.display = 'block';
            errBox.innerHTML = '❌ Network error: ' + e.message;
        }
    }

    async function launchVlcCurrent() {
        if (!activeStreamUrl) { alert('Pehle link resolve karein!'); return; }
        const track = document.getElementById('audioTrackSelect').value || 1;
        playInVlcCustom(encodeURIComponent(activeStreamUrl), track);
    }

    async function playInVlcCustom(encodedUrl, track) {
        const url = decodeURIComponent(encodedUrl);
        const trk = track || document.getElementById('audioTrackSelect').value || 1;
        try {
            const resp = await fetch('/api/play_vlc', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ stream_url: url, audio_track: parseInt(trk) })
            });
            const data = await resp.json();
            if (data.success) {
                alert('🚀 VLC Player launch ho gaya! Direct stream chal raha hai.');
            } else {
                alert('⚠️ VLC Error: ' + (data.message || 'VLC open nahi hua'));
            }
        } catch (e) {
            alert('Error: ' + e.message);
        }
    }

    function copyActiveStreamUrl() {
        if (!activeStreamUrl) { alert('Pehle link resolve karein!'); return; }
        navigator.clipboard.writeText(activeStreamUrl).then(() => {
            alert('✅ Direct Stream URL clipboard par copy ho gaya!');
        });
    }

    function copyCustomUrl(encodedUrl) {
        const url = decodeURIComponent(encodedUrl);
        navigator.clipboard.writeText(url).then(() => {
            alert('✅ Stream URL copy ho gaya!');
        });
    }
</script>
</body>
</html>"""

# ── HTTP Server Request Handler ────────────────────────────────────────────────

class RequestHandler(http.server.BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        if args and str(args[1]) not in ('200', '304'):
            super().log_message(fmt, *args)

    def do_HEAD(self):
        parsed = urllib.parse.urlparse(self.path)
        qp     = urllib.parse.parse_qs(parsed.query)
        path   = parsed.path
        if path == '/api/stream':
            raw_target = qp.get('url', [''])[0]
            if raw_target:
                target_url = make_safe_url(raw_target)
                headers = {'User-Agent': USER_AGENT}
                try:
                    req = urllib.request.Request(target_url, headers=headers)
                    with urllib.request.urlopen(req, timeout=8) as resp:
                        self.send_response(resp.status)
                        self.send_header('Content-Type', resp.headers.get('Content-Type', 'video/x-matroska'))
                        self.send_header('Accept-Ranges', 'bytes')
                        cl = resp.headers.get('Content-Length')
                        if cl: self.send_header('Content-Length', cl)
                        self.end_headers()
                        return
                except Exception:
                    pass
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        qp     = urllib.parse.parse_qs(parsed.query)
        path   = parsed.path

        # Streaming Proxy with Guaranteed Range/Seeking Support for VLC
        if path == '/api/stream':
            raw_target = qp.get('url', [''])[0]
            if not raw_target:
                self.send_response(400); self.end_headers()
                self.wfile.write(b'Missing url param'); return

            target_url = make_safe_url(raw_target)
            range_hdr  = self.headers.get('Range')
            headers    = {'User-Agent': USER_AGENT}
            if range_hdr:
                headers['Range'] = range_hdr

            try:
                req = urllib.request.Request(target_url, headers=headers)
                with urllib.request.urlopen(req, timeout=15) as resp:
                    status = resp.status
                    cl     = resp.headers.get('Content-Length')
                    cr     = resp.headers.get('Content-Range')
                    ct     = resp.headers.get('Content-Type', 'video/x-matroska')

                    self.send_response(status)
                    self.send_header('Content-Type', ct)
                    self.send_header('Accept-Ranges', 'bytes') # Crucial for VLC seeking!
                    self.send_header('Access-Control-Allow-Origin', '*')
                    if cl: self.send_header('Content-Length', cl)
                    if cr: self.send_header('Content-Range', cr)
                    self.end_headers()

                    while True:
                        chunk = resp.read(256 * 1024)
                        if not chunk: break
                        try:
                            self.wfile.write(chunk)
                            self.wfile.flush()
                        except (BrokenPipeError, ConnectionResetError):
                            break
            except Exception as e:
                try:
                    self.send_response(502); self.end_headers()
                    self.wfile.write(str(e).encode())
                except Exception:
                    pass
            return

        # Search API
        if path == '/api/search':
            q = qp.get('q', [''])[0]
            self._json(search_hdhub4u(q))
            return

        # Movie Details API
        if path == '/api/movie':
            url = qp.get('url', [''])[0]
            self._json(parse_movie_details(url))
            return

        # In-App HTML5 Web Player
        if path == '/watch':
            stream_url = qp.get('url', [''])[0]
            title = qp.get('t', ['Movie Stream'])[0]
            html = WATCH_PAGE.replace('__MOVIE_TITLE__', title).replace('__STREAM_URL_JSON__', json.dumps(stream_url))
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write(html.encode('utf-8'))
            return

        # M3U8 Playlist File Generator for VLC / External Players
        if path == '/api/playlist.m3u8':
            stream_url = qp.get('url', [''])[0]
            title = qp.get('t', ['Movie Stream'])[0]
            if '.m3u8' in stream_url or 'hdstream4u' in stream_url:
                ref_opt = "#EXTVLCOPT:http-referrer=https://hdstream4u.com/\n"
                caching_opt = "#EXTVLCOPT:network-caching=2000\n"
                target_pl_url = stream_url
            else:
                ref_opt = ""
                caching_opt = "#EXTVLCOPT:network-caching=5000\n#EXTVLCOPT:http-reconnect=true\n"
                target_pl_url = f"http://127.0.0.1:{PORT}/api/stream?url={urllib.parse.quote(stream_url)}"
            m3u = f"""#EXTM3U
#EXTINF:-1,{title}
{ref_opt}{caching_opt}{target_pl_url}
"""
            content = m3u.encode('utf-8')
            self.send_response(200)
            self.send_header('Content-Type', 'application/x-mpegurl')
            self.send_header('Content-Disposition', 'attachment; filename="streamhub.m3u8"')
            self.send_header('Content-Length', str(len(content)))
            self.end_headers()
            self.wfile.write(content)
            return

        # Frontend App
        if path in ('/', '/index.html'):
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write(HTML_PAGE.encode('utf-8'))
            return

        self.send_response(404); self.end_headers()

    def do_POST(self):
        length = int(self.headers.get('Content-Length', 0))
        raw_body = self.rfile.read(length)

        # Resolve API
        if self.path == '/api/resolve':
            try:
                body = json.loads(raw_body.decode('utf-8'))
                target_url = body.get('url', '')
                res = resolve_hubcloud(target_url)
                self._json(res)
            except Exception as e:
                self._json({"success": False, "error": str(e)}, status=500)
            return

        # VLC Player Launch API (Opens Real Desktop GUI Window)
        if self.path == '/api/play_vlc':
            try:
                body        = json.loads(raw_body.decode('utf-8'))
                stream_url  = body.get('stream_url', '')
                audio_track = body.get('audio_track', 1)

                if not stream_url:
                    self._json({"success": False, "message": "Stream URL missing"})
                    return

                if not os.path.exists(VLC_PATH):
                    self._json({"success": False, "message": f"VLC player nahi mila at {VLC_PATH}"})
                    return

                # Kill any invisible/hung background VLC instances that have no window handle
                # so the new VLC window can open cleanly in front of user
                try:
                    subprocess.run(
                        ['powershell', '-Command', 'Get-Process -Name vlc -ErrorAction SilentlyContinue | Where-Object { $_.MainWindowHandle -eq 0 } | Stop-Process -Force -ErrorAction SilentlyContinue'],
                        creationflags=0x08000000,
                        timeout=3
                    )
                except Exception:
                    pass

                # Build VLC options: force standalone Qt GUI window
                extra_opts = ['--no-one-instance', '--intf=qt']

                if '.m3u8' in stream_url or 'hdstream4u' in stream_url:
                    extra_opts.extend([
                        '--network-caching=2000',
                        '--http-referrer=https://hdstream4u.com/'
                    ])
                    final_play_target = stream_url
                else:
                    # High-bitrate 4K / MKV streaming optimizations:
                    # Route through local proxy to guarantee Accept-Ranges: bytes
                    # This enables instant forward / backward seeking in VLC without freezing or stopping
                    extra_opts.extend([
                        '--network-caching=5000',
                        '--http-reconnect',
                        '--file-caching=5000'
                    ])
                    final_play_target = f"http://127.0.0.1:{PORT}/api/stream?url={urllib.parse.quote(stream_url)}"

                # Audio track: only specify if audio_track > 1 so default track 1 is native
                if audio_track and int(audio_track) > 1:
                    extra_opts.append(f'--audio-track={int(audio_track) - 1}')

                opts_str = ' '.join(extra_opts)
                win_cmd = f'start "" "{VLC_PATH}" {opts_str} "{final_play_target}"'
                subprocess.Popen(win_cmd, shell=True)

                self._json({"success": True, "message": "VLC Player successfully launched! Window screen par open ho rahi hai."})
            except Exception as e:
                self._json({"success": False, "error": str(e)}, status=500)
            return

        self.send_response(404); self.end_headers()

    def _json(self, data, status=200):
        body = json.dumps(data, ensure_ascii=False).encode('utf-8')
        self.send_response(status)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers()
        self.wfile.write(body)

class ThreadedTCPServer(socketserver.ThreadingMixIn, socketserver.TCPServer):
    allow_reuse_address = True
    daemon_threads      = True

def run():
    print("=" * 55)
    print("       StreamHub Movie Streamer v5.0 — Netflix Mode")
    print("=" * 55)
    print(f"  VLC Player : {'FOUND [OK] (' + VLC_PATH + ')' if os.path.exists(VLC_PATH) else 'NOT FOUND'}")
    print(f"  Server URL : http://localhost:{PORT}")
    print("=" * 55)
    webbrowser.open(f"http://localhost:{PORT}")
    with ThreadedTCPServer(("", PORT), RequestHandler) as httpd:
        print(f"\n  Ready at http://localhost:{PORT}\n")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\nServer stopped.")

if __name__ == '__main__':
    run()
