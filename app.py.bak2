# ── HTTP Helpers ───────────────────────────────────────────────────────────────

def fetch_html(url, referer=None, extra_headers=None, timeout=15):
    headers = {
        'User-Agent': USER_AGENT,
        'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
        'Accept-Language': 'en-US,en;q=0.9,hi;q=0.8',
        'Accept-Encoding': 'gzip, deflate',
        'Connection': 'keep-alive',
    }
    if referer:
        headers['Referer'] = referer
    if extra_headers:
        headers.update(extra_headers)
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        raw = resp.read()
        final_url = resp.url
        try:
            raw = _gzip.decompress(raw)
        except Exception:
            pass
        return raw.decode('utf-8', errors='ignore'), final_url

def make_safe_url(url):
    """Ensures URL has properly percent-encoded path without double-encoding."""
    try:
        if not url or not url.startswith('http'):
            return url
        parsed = urllib.parse.urlsplit(url)
        unquoted_path = urllib.parse.unquote(parsed.path)
        clean_path = urllib.parse.quote(unquoted_path)
        return urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, clean_path, parsed.query, parsed.fragment))
    except Exception:
        return url

def check_link_alive(url, referer=None):
    """Fast check whether a stream URL actually works or returns 403 / quota error."""
    try:
        headers = {
            'User-Agent': USER_AGENT,
            'Range': 'bytes=0-100'
        }
        if referer:
            headers['Referer'] = referer
        safe_url = make_safe_url(url)
        req = urllib.request.Request(safe_url, headers=headers)
        with urllib.request.urlopen(req, timeout=5) as resp:
            data = resp.read(100)
            if b'NotEntitled' in data or b'<Error>' in data or b'downloadQuotaExceeded' in data:
                return False
            return resp.status in (200, 206)
    except Exception:
        return False

def resolve_gpdl(gpdl_url, referer=None):
    """Follows GPDL redirect to cryptonewz and extracts direct Google UserContent CDN link."""
    try:
        headers = {
            'User-Agent': USER_AGENT,
            'Referer': referer or 'https://gamerxyt.com/'
        }
        req = urllib.request.Request(gpdl_url, headers=headers)
        with urllib.request.urlopen(req, timeout=12) as resp:
            final_url = resp.url
            parsed = urllib.parse.urlparse(final_url)
            qs = urllib.parse.parse_qs(parsed.query)
            if 'link' in qs and qs['link'][0].startswith('http'):
                return qs['link'][0]
            html = resp.read().decode('utf-8', errors='ignore')
            m = re.search(r'href=["\'](https?://video-downloads\.googleusercontent\.com/[^"\']+)["\']', html)
            if m:
                return m.group(1)
            m = re.search(r'id=["\']downloadBtn["\'][^>]*href=["\'](https?://[^"\']+)["\']', html)
            if m:
                return m.group(1)
    except Exception as e:
        print("[GPDL] Resolve error:", e)
    return None

def unpack_packer(text):
    """De-obfuscates Dean Edwards packed JavaScript to extract hidden video URLs."""
    m = re.search(r'eval\((function\(p,a,c,k,e,d\).+?)\)\s*</script>', text, re.DOTALL)
    if not m:
        m = re.search(r'eval\((function\(p,a,c,k,e,d\).+?)\)', text, re.DOTALL)
    if m:
        raw = m.group(1)
        m_args = re.search(r"\}\('(.*)',\s*(\d+),\s*(\d+),\s*'([^']+)'\.split\('\|'\)", raw, re.DOTALL)
        if m_args:
            p, a, c, k = m_args.groups()
            a, c, k = int(a), int(c), k.split('|')
            def baseN(num, b):
                return ((num == 0) and "0") or (baseN(num // b, b).lstrip("0") + "0123456789abcdefghijklmnopqrstuvwxyz"[num % b])
            while c > 0:
                c -= 1
                key = baseN(c, a)
                val = k[c] if c < len(k) and k[c] else key
                p = re.sub(r'\b' + key + r'\b', val, p)
            return p
    return None

def resolve_hdstream4u(url):
    """Resolves hdstream4u.com file URLs to adaptive HLS master.m3u8 streams."""
    try:
        headers = {
            'User-Agent': USER_AGENT,
            'Referer': f'{HDHUB4U_BASE_URL}/'
        }
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            text = resp.read().decode('utf-8', errors='ignore')

        unpacked = unpack_packer(text)
        if unpacked:
            m3u8s = re.findall(r'https?://[^\s"\'<>]+\.m3u8[^\s"\'<>]*', unpacked)
            if m3u8s:
                return m3u8s[0]
            hlss = re.findall(r'https?://[^\s"\'<>]+\.txt[^\s"\'<>]*', unpacked)
            if hlss:
                return hlss[0]

        m = re.findall(r'https?://[^\s"\'<>]+\.m3u8[^\s"\'<>]*', text)
        if m:
            return m[0]
    except Exception as e:
        print("[HDStream4u] error:", e)
    return None

def parse_m3u8_audio_tracks(m3u8_url):
    """Directly extracts audio track metadata from HLS master playlist."""
    tracks = []
    try:
        headers = {
            'User-Agent': USER_AGENT,
            'Referer': 'https://hdstream4u.com/'
        }
        req = urllib.request.Request(m3u8_url, headers=headers)
        with urllib.request.urlopen(req, timeout=6) as resp:
            content = resp.read().decode('utf-8', errors='ignore')
        track_counter = 1
        for m in re.finditer(r'#EXT-X-MEDIA:TYPE=AUDIO.*?NAME="([^"]+)".*?LANGUAGE="([^"]*)"', content):
            name = m.group(1)
            lang = m.group(2)
            tracks.append({
                "track_num": track_counter,
                "stream_index": track_counter - 1,
                "lang": name,
                "codec": "AAC",
                "channels": "Stereo",
                "label": f"Track {track_counter}: {name} ({lang.upper() if lang else 'Audio'})"
            })
            track_counter += 1
    except Exception as e:
        print("[M3U8 Audio Probe] error:", e)
    return tracks

def probe_audio_tracks(stream_url, referer=None):
    """Probes audio streams using ffprobe when available."""
    audio_tracks = []
    if not FFPROBE_PATH or not os.path.exists(FFPROBE_PATH):
        return audio_tracks
    try:
        hdr = f'User-Agent: {USER_AGENT}\r\n'
        if referer:
            hdr += f'Referer: {referer}\r\n'
        cmd = [
            FFPROBE_PATH, '-v', 'quiet',
            '-print_format', 'json',
            '-show_streams',
            '-probesize', '4000000',
            '-analyzeduration', '3000000',
            '-headers', hdr,
            stream_url
        ]
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        out, _ = p.communicate(timeout=10)
        data = json.loads(out)
        default_lang_order = ['Hindi', 'Tamil', 'Telugu', 'Kannada', 'Malayalam']
        track_counter = 1
        for s in data.get('streams', []):
            if s.get('codec_type') == 'audio':
                tags = s.get('tags', {})
                raw_lang  = tags.get('language', 'und').lower()
                raw_title = tags.get('title', '')
                if any(k in raw_title.lower() for k in ['hdhub4u', 'hubcloud', 'uploaded', '4khdhub']):
                    lang_name = LANG_MAP.get(raw_lang)
                else:
                    lang_name = raw_title or LANG_MAP.get(raw_lang)
                if not lang_name or lang_name == 'Audio Track':
                    lang_name = default_lang_order[track_counter - 1] if track_counter <= len(default_lang_order) else f"Track {track_counter}"
                codec    = s.get('codec_name', '').upper()
                channels = s.get('channels', 2)
                ch_str   = "5.1" if channels == 6 else ("7.1" if channels == 8 else "Stereo")
                audio_tracks.append({
                    "track_num":    track_counter,
                    "stream_index": s.get('index'),
                    "lang":         lang_name,
                    "codec":        codec,
                    "channels":     ch_str,
                    "label":        f"Track {track_counter}: {lang_name} ({codec} {ch_str})"
                })
                track_counter += 1
    except Exception as e:
        print("[Audio Probe] error:", e)
    return audio_tracks

# ── HDHub4u Search & Details ───────────────────────────────────────────────────

def search_hdhub4u(query):
    results = []
    try:
        api_url = (
            f'{HDHUB4U_SEARCH_API}?q={urllib.parse.quote(query)}'
            f'&query_by=post_title,category,stars,director,imdb_id'
            f'&query_by_weights=4,2,2,2,4'
            f'&sort_by=sort_by_date:desc'
            f'&limit=12'
            f'&highlight_fields=none'
            f'&use_cache=true'
            f'&page=1'
        )
        headers = {
            'User-Agent': USER_AGENT,
            'Accept': '*/*',
            'Referer': f'{HDHUB4U_BASE_URL}/',
            'Origin': HDHUB4U_BASE_URL
        }
        req = urllib.request.Request(api_url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode('utf-8'))
            hits = data.get('hits', [])
            for h in hits:
                doc = h.get('document', {})
                raw_permalink = doc.get('permalink', '')
                pu = urllib.parse.urlparse(raw_permalink)
                fixed_permalink = f"{HDHUB4U_BASE_URL}{pu.path}" if pu.path else raw_permalink
                results.append({
                    "title":     doc.get('post_title', 'Untitled'),
                    "permalink": fixed_permalink,
                    "thumbnail": doc.get('post_thumbnail', doc.get('featured_image', '')),
                    "year":      doc.get('release_year', '')
                })
    except Exception as e:
        print("[HDHub4u Search] error:", e)
    return results

def find_hls_stream_for_title(raw_title):
    """Automatically finds Netflix-style adaptive HLS stream for any movie title."""
    try:
        clean = re.split(r'[\.\s_\-]+(202\d|201\d|19\d\d|4k|2160p|1080p|720p|480p|ds4k|web|bluray|hindi)', raw_title, flags=re.I)[0]
        clean = re.sub(r'\s*[-|]\s*(HDHub4u|4KHDHub|HubCloud|HubDrive|Watch Online).*', '', clean, flags=re.I)
        clean = re.sub(r'[^a-zA-Z0-9\s]', ' ', clean).strip()
        if not clean:
            return None
        print(f"[Auto-HLS] Searching HDHub4u for title: '{clean}'")
        hits = search_hdhub4u(clean)
        if hits:
            post_url = hits[0]['permalink']
            req = urllib.request.Request(post_url, headers={'User-Agent': USER_AGENT})
            with urllib.request.urlopen(req, timeout=8) as resp:
                hp = resp.read().decode('utf-8', errors='ignore')
            m_stream = re.search(r'https?://hdstream4u\.com/file/([a-zA-Z0-9]+)', hp)
            if m_stream:
                hdstream_url = m_stream.group(0)
                print(f"[Auto-HLS] Found hdstream4u: {hdstream_url}")
                m3u8 = resolve_hdstream4u(hdstream_url)
                return m3u8
    except Exception as e:
        print("[Auto-HLS] Discovery error:", e)
    return None

def parse_movie_details(post_url):
    try:
        html, _ = fetch_html(post_url)
        qualities = []
        seen = set()

        # Check for Watch Online (hdstream4u) link first and prioritize it
        m_stream = re.search(r'https?://hdstream4u\.com/file/([a-zA-Z0-9]+)', html)
        if m_stream:
            hdstream_link = m_stream.group(0)
            seen.add(hdstream_link)
            qualities.append({
                "title": "⚡ [Netflix Mode] Ultra-Fast Stream (Instant Scrubbing)",
                "link": hdstream_link
            })

        for m in re.finditer(r'<a[^>]+href=["\'](https?://[^\s"\'<>]+)["\'][^>]*>(.*?)</a>', html, re.I | re.DOTALL):
            href = m.group(1).strip()
            text = re.sub(r'<[^>]+>', '', m.group(2)).strip()
            if href in seen:
                continue
            if not any(d in href for d in ['hubcloud', 'hubdrive', 'hubcdn', '4khdhub', 'drive', 'file', 'hdstream4u']):
                continue
            if any(k in href.lower() for k in ['admin', 'login', 'register', 'telegram', 'facebook', 'twitter']):
                continue
            if any(q in text.lower() or q in href.lower() for q in ['480p', '720p', '1080p', '2160p', '4k', 'hevc', 'download', 'drive', 'file', 'watch']):
                seen.add(href)
                qualities.append({
                    "title": text or "Download Link",
                    "link": href
                })
        return {"success": True, "qualities": qualities}
    except Exception as e:
        return {"success": False, "error": str(e), "qualities": []}

# ── Main Link Resolver ─────────────────────────────────────────────────────────

def resolve_hubcloud(input_url):
    try:
        if not input_url.startswith('http'):
            return {"success": False, "error": "Invalid URL — http/https se shuru hona chahiye"}

        # Case 1: Direct hdstream4u link
        if 'hdstream4u.com' in input_url:
            m3u8 = resolve_hdstream4u(input_url)
            if m3u8:
                tracks = parse_m3u8_audio_tracks(m3u8)
                return {
                    "success": True,
                    "title": "HDStream4u Stream",
                    "size": "Adaptive HLS",
                    "stream_url": m3u8,
                    "audio_tracks": tracks,
                    "watch_online_url": f"/watch?url={urllib.parse.quote(m3u8)}&t=Movie+Stream",
                    "mirrors": [{
                        "name": "⚡ [Netflix Mode] Ultra-Fast HLS Stream (Instant Seeking)",
                        "url": m3u8,
                        "alive": True,
                        "type": "hls"
                    }]
                }

        html, current_url = fetch_html(input_url)

        # Title and file size detection
        title_m = re.search(r'<title>(.*?)</title>', html, re.I)
        raw_title = title_m.group(1).strip() if title_m else "Movie Stream"
        movie_title = re.sub(
            r'\s*[-|]?\s*(HDHub4u|4KHDHub|HubCloud|HubDrive|StreamHub|Watch Online|Free Download)(\.[a-z]+)?(\.mkv|\.mp4)?.*$',
            '', raw_title, flags=re.I
        ).strip()
        movie_title = re.sub(r'(\.mkv|\.mp4)$', '', movie_title, flags=re.I).strip()
        size_m = re.search(r'([\d.,]+\s*(?:GB|MB|KB))', html, re.I)
        file_size = size_m.group(1).strip() if size_m else "Unknown Size"

        # Step 1: Follow HubDrive -> HubCloud
        m_hubcloud = re.search(r'href=["\'](https?://hubcloud\.[a-z]+/drive/[^"\'\s]+)["\']', html)
        if m_hubcloud and '/drive/admin' not in m_hubcloud.group(1):
            target_hubcloud = m_hubcloud.group(1)
            print(f"[Resolver] Followed HubDrive to: {target_hubcloud}")
            html, current_url = fetch_html(target_hubcloud, referer=input_url)

        # Step 2: Follow HubCloud -> GamerXYT
        m_gamer = re.search(r'href=["\'](https?://gamerxyt\.com/hubcloud\.php[^"\'\s]+)["\']', html)
        if m_gamer:
            gamer_url = m_gamer.group(1).replace('&amp;', '&')
            print(f"[Resolver] Followed HubCloud to GamerXYT: {gamer_url[:60]}")
            html, current_url = fetch_html(gamer_url, referer=current_url)

        # Step 3: Discover all mirror links and test liveness
        mirrors = []
        seen_urls = set()
        is_4k = any(k in raw_title.lower() for k in ['4k', '2160p', 'uhd', '60fps', 'bluray'])

        # A. Check for pixel / gpdl HubCloud links (Google 10Gbps CDN)
        cdn_links = re.findall(r'href=["\'](https?://(?:pixel|gpdl)\.hubcloud\.[a-z]+/[^"\'\s]+)["\']', html)
        for cdn_url in cdn_links:
            cdn_url = cdn_url.replace('&amp;', '&')
            print(f"[Resolver] Found CDN link: {cdn_url[:60]}")
            direct_g = resolve_gpdl(cdn_url, referer=current_url)
            if direct_g and direct_g not in seen_urls:
                seen_urls.add(direct_g)
                alive = check_link_alive(direct_g)
                server_label = (
                    "[10Gbps] Google High-Speed Server (Original 4K 60FPS MKV)" if is_4k
                    else "[10Gbps] Google High-Speed Server (Original Quality MKV)"
                )
                mirrors.append({
                    'name': server_label + (' [OK]' if alive else ' [FAIL]'),
                    'url': direct_g,
                    'alive': alive,
                    'type': 'google_cdn'
                })
                print(f"  -> Google CDN stream: {'ACTIVE [OK]' if alive else 'OFFLINE [FAIL]'}")

        # B. Check for direct cryptonewz links
        for m in re.finditer(r'href=["\'](https?://cryptonewz\.online/dl\.php\?link=[^"\'\s]+)["\']', html):
            c_url = m.group(1).replace('&amp;', '&')
            direct_g = resolve_gpdl(c_url, referer=current_url)
            if direct_g and direct_g not in seen_urls:
                seen_urls.add(direct_g)
                alive = check_link_alive(direct_g)
                server_label = (
                    "[10Gbps] Google High-Speed Server (Original 4K 60FPS MKV)" if is_4k
                    else "[10Gbps] Google High-Speed Server (Original Quality MKV)"
                )
                mirrors.append({
                    'name': server_label + (' [OK]' if alive else ' [FAIL]'),
                    'url': direct_g,
                    'alive': alive,
                    'type': 'google_cdn'
                })

        # C. Check for direct video-downloads.googleusercontent.com links
        for m in re.finditer(r'href=["\'](https?://video-downloads\.googleusercontent\.com/[^"\'\s]+)["\']', html):
            g_url = m.group(1).replace('&amp;', '&')
            if g_url not in seen_urls:
                seen_urls.add(g_url)
                alive = check_link_alive(g_url)
                server_label = (
                    "[10Gbps] Google High-Speed Server (Original 4K 60FPS MKV)" if is_4k
                    else "[10Gbps] Google High-Speed Server (Original Quality MKV)"
                )
                mirrors.append({
                    'name': server_label + (' [OK]' if alive else ' [FAIL]'),
                    'url': g_url,
                    'alive': alive,
                    'type': 'google_cdn'
                })

        # D. Check for HubCDN direct ?r= base64
        m_r = re.search(r'[?&]r=([a-zA-Z0-9+/=]+)', html)
        if m_r:
            try:
                dec = base64.b64decode(m_r.group(1)).decode('utf-8', errors='ignore')
                m_link = re.search(r'link=(https?://[^\s&"\']+)', dec)
                if m_link:
                    direct_url = m_link.group(1)
                    if direct_url not in seen_urls:
                        seen_urls.add(direct_url)
                        alive = check_link_alive(direct_url)
                        is_r2 = 'r2.dev' in direct_url
                        name = ('[Fast Cloud] R2 Direct Stream' if is_r2 else '[10Gbps] Google High-Speed Server')
                        mirrors.append({
                            'name': name + (' [OK]' if alive else ' [FAIL]'),
                            'url': direct_url,
                            'alive': alive,
                            'type': 'r2_dev' if is_r2 else 'google_cdn'
                        })
                        print(f"  -> HubCDN stream: {'ACTIVE [OK]' if alive else 'OFFLINE [FAIL]'}")
            except Exception as e:
                print("[Resolver] Error decoding hubcdn ?r=:", e)

        # E. Check for R2 Cloudflare storage links
        for m in re.finditer(r'href=["\'](https?://[a-z0-9]+\.r2\.cloudflarestorage\.com/[^"\']+)["\']', html):
            r2_url = m.group(1).replace('&amp;', '&')
            if r2_url not in seen_urls:
                seen_urls.add(r2_url)
                alive = check_link_alive(r2_url)
                status_note = ' [OK]' if alive else ' (Cloudflare R2 Disabled / 403)'
                mirrors.append({
                    'name': f'Cloudflare FSL Server{status_note}',
                    'url': r2_url,
                    'alive': alive,
                    'type': 'r2'
                })
                print(f"  -> R2 link: {'ACTIVE [OK]' if alive else 'DEAD (403)'}")

        # F. Check for workers.dev links
        for m in re.finditer(r'href=["\'](https?://[a-zA-Z0-9\-_.]+\.workers\.dev/[^"\'\s]+)["\']', html):
            w_url = make_safe_url(m.group(1).replace('&amp;', '&'))
            if w_url not in seen_urls:
                seen_urls.add(w_url)
                alive = check_link_alive(w_url)
                status_note = ' [OK]' if alive else ' (Quota Exceeded / 403)'
                label = (
                    f"[Full Seeking] Cloudflare Worker Server (Original 4K 60FPS MKV){status_note}" if is_4k
                    else f"[Full Seeking] Cloudflare Worker Server (Original MKV){status_note}"
                )
                mirrors.append({
                    'name': label,
                    'url': w_url,
                    'alive': alive,
                    'type': 'worker'
                })

        # Pick best working stream:
        # Prioritize mirrors with full byte-range seeking support (worker, r2_dev) over google_cdn
        # so playback and seekbar scrubbing NEVER freeze or stop.
        working_mirrors = [m for m in mirrors if m['alive']]
        working_mirrors.sort(key=lambda m: 0 if m['type'] in ('worker', 'r2_dev') else (1 if m['type'] == 'google_cdn' else 2))
        best_stream_url = working_mirrors[0]['url'] if working_mirrors else (mirrors[0]['url'] if mirrors else None)

        if not best_stream_url:
            return {
                "success": False,
                "error": "Koi working stream link nahi mila. Server offline ho sakta hai."
            }

        # In-App Watch online player URL
        watch_online_url = f"/watch?url={urllib.parse.quote(best_stream_url)}&t={urllib.parse.quote(movie_title)}"

        # Audio tracks: Parse from M3U8 if HLS, else probe via ffprobe or extract from title
        audio_tracks = []
        if '.m3u8' in best_stream_url or 'acek-cdn' in best_stream_url:
            audio_tracks = parse_m3u8_audio_tracks(best_stream_url)
        if not audio_tracks:
            audio_tracks = probe_audio_tracks(best_stream_url)

        # Smart fallback: extract language tracks from title if available
        if not audio_tracks:
            raw_lower = raw_title.lower()
            if 'dual' in raw_lower or ('hin' in raw_lower and 'eng' in raw_lower):
                audio_tracks = [
                    {"track_num": 1, "stream_index": 0, "lang": "Hindi", "codec": "DD5.1", "channels": "5.1", "label": "Track 1: Hindi (Default / DD5.1)"},
                    {"track_num": 2, "stream_index": 1, "lang": "English", "codec": "DTS-HD/AAC", "channels": "7.1/5.1", "label": "Track 2: English"},
                    {"track_num": 3, "stream_index": 2, "lang": "Multi-Audio", "codec": "All Tracks", "channels": "Auto", "label": "Track 3: VLC Native Audio Switcher"}
                ]
            elif 'hindi' in raw_lower or 'hin' in raw_lower:
                audio_tracks = [
                    {"track_num": 1, "stream_index": 0, "lang": "Hindi", "codec": "Original", "channels": "Auto", "label": "Track 1: Hindi (Original)"}
                ]

        return {
            "success":          True,
            "title":            movie_title,
            "size":             file_size,
            "stream_url":       best_stream_url,
            "audio_tracks":     audio_tracks,
            "watch_online_url": watch_online_url,
            "mirrors":          mirrors
        }

    except Exception as e:
        return {"success": False, "error": str(e)}

# ── Frontend HTML/CSS/JS ───────────────────────────────────────────────────────

WATCH_PAGE = """<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>__MOVIE_TITLE__ - StreamHub Player</title>
<script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
  body {
    background: #000;
    color: #fff;
    display: flex;
    flex-direction: column;
    height: 100vh;
    overflow: hidden;
  }
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    background: rgba(15, 23, 42, 0.95);
    border-bottom: 1px solid #1e293b;
    z-index: 10;
  }
  .top-bar h1 {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 60%;
    color: #f8fafc;
  }
  .btn-back {
    background: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 0.85rem;
    text-decoration: none;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .btn-back:hover { background: #334155; }
  .badge-hls {
    background: rgba(99, 102, 241, 0.25);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.5);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    margin-left: 12px;
  }
  .video-container {
    flex: 1;
    position: relative;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  video {
    width: 100%;
    height: 100%;
    max-height: calc(100vh - 54px);
    outline: none;
  }
</style>
</head>
<body>
  <div class="top-bar">
    <div style="display:flex;align-items:center;">
      <a href="/" class="btn-back">← Back</a>
      <span class="badge-hls">⚡ NETFLIX MODE ACTIVE</span>
    </div>
    <h1>__MOVIE_TITLE__</h1>
    <div style="font-size:0.8rem;color:#94a3b8;">StreamHub v5.0</div>
  </div>
  <div class="video-container">
    <video id="videoPlayer" controls autoplay playsinline></video>
  </div>
  <script>
    const streamUrl = __STREAM_URL_JSON__;
    const video = document.getElementById('videoPlayer');

    if (streamUrl) {
      if (streamUrl.includes('.m3u8')) {
        if (Hls.isSupported()) {
          const hls = new Hls({
            enableWorker: true,
            lowLatencyMode: false,
            backBufferLength: 90
          });
          hls.loadSource(streamUrl);
          hls.attachMedia(video);
          hls.on(Hls.Events.MANIFEST_PARSED, function() {
            video.play().catch(e => console.log('Autoplay deferred:', e));
          });
        } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
          video.src = streamUrl;
          video.play();
        }
      } else {
        video.src = streamUrl;
        video.play();
      }
    }
  </script>
</body>
</html>"""

HTML_PAGE = """<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StreamHub - Direct VLC Movie Streamer</title>
<style>
:root {
    --bg: #07090e;
    --card: #111622;
    --border: #1f293d;
    --accent: #6366f1;
    --accent-hover: #4f46e5;
    --text: #f8fafc;
    --text-sub: #94a3b8;
}
* { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
body { background: var(--bg); color: var(--text); padding: 20px 14px; min-height: 100vh; }
.container { max-width: 760px; margin: 0 auto; }
header { text-align: center; margin-bottom: 24px; }
header h1 {
    font-size: 2.2rem;
    font-weight: 800;
    background: linear-gradient(135deg, #a5b4fc, #6366f1, #c084fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 8px;
}
header p { color: var(--text-sub); font-size: 0.95rem; }
.card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 24px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    margin-bottom: 22px;
}
.input-row { display: flex; gap: 10px; flex-direction: column; }
@media (min-width: 600px) { .input-row { flex-direction: row; } }
input[type="text"] {
    flex: 1;
    padding: 14px 18px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: #0f172a;
    color: #fff;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s;
}
input[type="text"]:focus { border-color: var(--accent); }
button.btn-primary {
    background: var(--accent);
    color: white;
    border: none;
    padding: 14px 24px;
    border-radius: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s, transform 0.1s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}
button.btn-primary:hover { background: var(--accent-hover); }
button.btn-primary:disabled { opacity: 0.6; cursor: not-allowed; }
.search-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-top: 14px; }
.movie-card {
    background: #0f172a;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
